+// The characters that a run of glyphs sharing one HarfBuzz cluster stands for.
+struct GlyphCluster {
+    uint32_t startOffset;
+    uint32_t endOffset;
+    int numGlyphs;
+};
+
+// HarfBuzz keeps cluster values monotonic: ascending in a left-to-right run and descending in a
+// right-to-left one. A cluster ends where the next one in text order starts.
+static uint32_t clusterEndIndex(const TextShapeRun& run, uint32_t glyphIndex, Direction direction)
+{
+    const auto& glyphs = run.glyphs();
+    const auto characterIndex = glyphs[glyphIndex].characterIndex;
+    if(direction == Direction::Ltr) {
+        for(auto index = glyphIndex + 1; index < glyphs.size(); ++index) {
+            if(glyphs[index].characterIndex > characterIndex) {
+                return glyphs[index].characterIndex;
+            }
+        }
+    } else {
+        for(auto index = glyphIndex; index > 0; --index) {
+            if(glyphs[index - 1].characterIndex > characterIndex) {
+                return glyphs[index - 1].characterIndex;
+            }
+        }
+    }
+
+    return run.length();
+}
+
+// Cairo fails the whole context on text that is not valid UTF-8, and before 1.18 on Unicode
+// noncharacters too, so those become U+FFFD here.
+static void appendClusterText(std::string& output, const UString& text, uint32_t startOffset, uint32_t endOffset)
+{
+    while(startOffset < endOffset) {
+        uint32_t character;
+        U16_NEXT(text, startOffset, endOffset, character);
+        if(character == 0 || U_IS_SURROGATE(character) || U_IS_UNICODE_NONCHAR(character))
+            character = 0xFFFD;
+        char buffer[U8_MAX_LENGTH];
+        int length = 0;
+        U8_APPEND_UNSAFE(buffer, length, character);
+        output.append(buffer, length);
+    }
+}
