#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"
version=${1:-8.2.36}
flavor=nts
source "$root/scripts/php-env.sh"
files=()
while IFS= read -r -d '' file; do
  "$php" -n -l "$file" >/dev/null
  [[ $file == *.stub.php ]] || files+=("$file")
done < <(git ls-files --cached --others --exclude-standard -z -- '*.php')
if ((${#files[@]})); then
  client="$TMPDIR/php-plutobook-fcgi.inc"
  archive=$("$root/scripts/fetch-source" php-8.2.36.tar.xz)
  tar -xOf "$archive" php-8.2.36/sapi/fpm/tests/fcgi.inc > "$client"
  "$php" tools/qa/vendor/bin/phpcs --standard=phpcs.xml.dist "${files[@]}"
  "$php" tools/qa/vendor/bin/phpstan analyse --no-progress --configuration=phpstan.neon.dist \
    --autoload-file="$client" "${files[@]}"
fi
