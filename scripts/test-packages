#!/usr/bin/env bash
# Install each package from scripts/build-packages into a clean container with that
# distribution's PHP, render a page through the enabled extension, then remove it.
# Usage: scripts/test-packages [SCENARIO...]     (default: all; see the table below)
# Containers need network access for their package repositories. CONTAINER_ENGINE
# picks podman or docker. Logs go to build/portable/package-tests/.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
packages="$root/build/portable/packages"
logs="$root/build/portable/package-tests"
engine=${CONTAINER_ENGINE:-$(command -v podman || command -v docker)}

apt_install='export DEBIAN_FRONTEND=noninteractive; apt-get -qq update && apt-get -qq install -y --no-install-recommends'
# Ondřej Surý's PHP builds, for PHP versions the distribution lacks.
sury_debian="$apt_install ca-certificates curl lsb-release && curl -fsSLo /tmp/keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb && dpkg -i /tmp/keyring.deb && echo \"deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ \$(lsb_release -sc) main\" > /etc/apt/sources.list.d/php.list"
sury_ubuntu="$apt_install software-properties-common gpg-agent && add-apt-repository -y ppa:ondrej/php"
# Remi's modular streams, for PHP versions AppStream lacks.
remi() { echo "dnf -y -q install epel-release https://rpms.remirepo.net/enterprise/remi-release-$1.rpm && dnf -y -q module reset php && dnf -y -q module enable php:remi-$2"; }

# name | image | package glob | PHP setup before installing the package
scenarios=(
  "debian12-php8.2|docker.io/library/debian:12|php8.2-plutobook_*.deb|true"
  "ubuntu2404-php8.3|docker.io/library/ubuntu:24.04|php8.3-plutobook_*.deb|true"
  "debian13-php8.4|docker.io/library/debian:13|php8.4-plutobook_*.deb|true"
  "ubuntu2204-php8.3-sury|docker.io/library/ubuntu:22.04|php8.3-plutobook_*.deb|$sury_ubuntu"
  "debian13-php8.5-sury|docker.io/library/debian:13|php8.5-plutobook_*.deb|$sury_debian"
  "debian13-php8.6-sury|docker.io/library/debian:13|php8.6-plutobook_*.deb|$sury_debian"
  "el8-php8.2|docker.io/library/almalinux:8|php-plutobook-*.php82.el8.x86_64.rpm|dnf -y -q module enable php:8.2"
  "el8-php8.4-remi|docker.io/library/almalinux:8|php-plutobook-*.php84.el8.x86_64.rpm|$(remi 8 8.4)"
  "el9-php8.3|docker.io/library/almalinux:9|php-plutobook-*.php83.el9.x86_64.rpm|dnf -y -q module enable php:8.3"
  "el9-php8.5-remi|docker.io/library/almalinux:9|php-plutobook-*.php85.el9.x86_64.rpm|$(remi 9 8.5)"
  "el9-php8.6-remi|docker.io/library/almalinux:9|php-plutobook-*.php86.el9.x86_64.rpm|$(remi 9 8.6)"
  "el10-php8.3|docker.io/library/almalinux:10|php-plutobook-*.php83.el10.x86_64.rpm|true"
  "el10-php8.4-remi|docker.io/library/almalinux:10|php-plutobook-*.php84.el10.x86_64.rpm|$(remi 10 8.4)"
)

# tools/packages/check-install installs, renders, removes and looks for leftovers.
selected=("$@")
mkdir -p "$logs"
failed=0
for scenario in "${scenarios[@]}"; do
  IFS='|' read -r name image glob setup <<<"$scenario"
  if ((${#selected[@]})) && [[ " ${selected[*]} " != *" $name "* ]]; then continue; fi
  mapfile -t matches < <(compgen -G "$packages/$glob" || true)
  ((${#matches[@]} == 1)) || { echo "$name: expected one package matching $glob" >&2; failed=1; continue; }
  printf '%-26s ' "$name"
  if "$engine" run --rm --quiet --security-opt label=disable -v "${matches[0]}:/pkg/${matches[0]##*/}:ro" \
      -v "$root/tools/packages/check-install:/check-install:ro" "$image" bash -c \
      "{ $setup; } >/tmp/setup.log 2>&1 || { tail -20 /tmp/setup.log; exit 3; }; sh /check-install" \
      > "$logs/$name.log" 2>&1; then
    tr '\n' ' ' < "$logs/$name.log"
    echo
  else
    echo "FAILED (build/portable/package-tests/$name.log)"
    sed 's/^/    /' "$logs/$name.log" | tail -15
    failed=1
  fi
done
exit "$failed"
