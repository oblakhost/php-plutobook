#!/usr/bin/env bash
# Install each package from scripts/build-packages into a clean container with that
# distribution's PHP, render a page through the enabled extension, then remove it.
# Usage: scripts/test-packages [SCENARIO...]     (default: all; see the table below)
# Containers need network access for their package repositories. CONTAINER_ENGINE
# picks podman or docker. Logs go to build/portable/package-tests/.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
packages="$root/build/portable/packages"
logs="$root/build/portable/package-tests"
engine=${CONTAINER_ENGINE:-$(command -v podman || command -v docker)}
# Packages of the host's architecture; the base images run natively on x86_64 and aarch64.
case $(uname -m) in
  x86_64) deb=amd64 rpm=x86_64 ;;
  aarch64) deb=arm64 rpm=aarch64 ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

apt_install='export DEBIAN_FRONTEND=noninteractive; apt-get -qq update && apt-get -qq install -y --no-install-recommends'
# Ondřej Surý's PHP builds, for PHP versions the distribution lacks.
sury_debian="$apt_install ca-certificates curl lsb-release && curl -fsSLo /tmp/keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb && dpkg -i /tmp/keyring.deb && echo \"deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ \$(lsb_release -sc) main\" > /etc/apt/sources.list.d/php.list"
sury_ubuntu="$apt_install software-properties-common gpg-agent && add-apt-repository -y ppa:ondrej/php"
# Remi's modular streams, for PHP versions AppStream lacks.
remi() { echo "dnf -y -q install epel-release https://rpms.remirepo.net/enterprise/remi-release-$1.rpm && dnf -y -q module reset php && dnf -y -q module enable php:remi-$2"; }
# cPanel's public EasyApache 4 repositories serve ea-php without a cPanel install.
ea4_key=https://securedownloads.cpanel.net/cPanelPublicPkgKey.asc
ea4_el() { echo "printf '%s\n' '[EA4]' 'name=EA4' 'baseurl=http://httpupdate.cpanel.net/cpanelsync/repos/$1/EA4/' 'gpgcheck=$2' 'gpgkey=$ea4_key' > /etc/yum.repos.d/EA4.repo"; }
ea4_ubuntu() { echo "$apt_install ca-certificates curl && mkdir -p /etc/apt/keyrings && curl -fsSLo /etc/apt/keyrings/cpanel-ea4.asc $ea4_key && echo 'deb [signed-by=/etc/apt/keyrings/cpanel-ea4.asc] mirror://httpupdate.cpanel.net/ea4-$1-mirrorlist ./' > /etc/apt/sources.list.d/EA4.list"; }

# name | image | package globs (space-separated) | PHP setup before installing the package
#   | check script in tools/packages/ (default check-install)
scenarios=(
  "debian12-php8.2|docker.io/library/debian:12|php8.2-plutobook_*_$deb.deb|true"
  "ubuntu2404-php8.3|docker.io/library/ubuntu:24.04|php8.3-plutobook_*_$deb.deb|true"
  "debian13-php8.4|docker.io/library/debian:13|php8.4-plutobook_*_$deb.deb|true"
  "ubuntu2204-php8.3-sury|docker.io/library/ubuntu:22.04|php8.3-plutobook_*_$deb.deb|$sury_ubuntu"
  "debian13-php8.5-sury|docker.io/library/debian:13|php8.5-plutobook_*_$deb.deb|$sury_debian"
  "debian13-php8.6-sury|docker.io/library/debian:13|php8.6-plutobook_*_$deb.deb|$sury_debian"
  "el8-php8.2|docker.io/library/almalinux:8|php-plutobook-*.php82.el8.$rpm.rpm|dnf -y -q module enable php:8.2"
  "el8-php8.4-remi|docker.io/library/almalinux:8|php-plutobook-*.php84.el8.$rpm.rpm|$(remi 8 8.4)"
  "el9-php8.3|docker.io/library/almalinux:9|php-plutobook-*.php83.el9.$rpm.rpm|dnf -y -q module enable php:8.3"
  "el9-php8.5-remi|docker.io/library/almalinux:9|php-plutobook-*.php85.el9.$rpm.rpm|$(remi 9 8.5)"
  "el9-php8.6-remi|docker.io/library/almalinux:9|php-plutobook-*.php86.el9.$rpm.rpm|$(remi 9 8.6)"
  "el10-php8.3|docker.io/library/almalinux:10|php-plutobook-*.php83.el10.$rpm.rpm|true"
  "el10-php8.4-remi|docker.io/library/almalinux:10|php-plutobook-*.php84.el10.$rpm.rpm|$(remi 10 8.4)"
)
# cPanel EasyApache 4 packages exist only for x86_64, as cPanel does. EL10's rpm rejects
# cPanel's signing key (SHA-1 self-signatures), so that test repository skips signature
# checks.
if [[ $rpm == x86_64 ]]; then
  scenarios+=(
    "cpanel-el8-php8.2|docker.io/library/almalinux:8|oblak-ea-php82-plutobook-*.el8.x86_64.rpm|$(ea4_el CentOS/8 1)"
    "cpanel-el9-php8.4|docker.io/library/almalinux:9|oblak-ea-php84-plutobook-*.el9.x86_64.rpm|$(ea4_el CentOS/9 1)"
    "cpanel-el10-php8.6|docker.io/library/almalinux:10|oblak-ea-php86-plutobook-*.el10.x86_64.rpm|$(ea4_el Almalinux/10 0)"
    "cpanel-ubuntu2204-php8.3|docker.io/library/ubuntu:22.04|oblak-ea-php83-plutobook_*_amd64.deb|$(ea4_ubuntu u22)"
    # Skipped while cPanel's Ubuntu 24.04 repository is broken: since 2026-11-27 its
    # InRelease lists older Packages files than every mirror serves, so apt rejects them.
    # The same deb passes on 22.04. Put it back once the index matches (pdf-ext-zcs.17).
    # "cpanel-ubuntu2404-php8.5|docker.io/library/ubuntu:24.04|oblak-ea-php85-plutobook_*_amd64.deb|$(ea4_ubuntu u24)"
    # Two packages in one transaction, with cPanel's restart scripts and cagefsctl stubbed.
    "cpanel-el9-scripts|docker.io/library/almalinux:9|oblak-ea-php82-plutobook-*.el9.x86_64.rpm oblak-ea-php83-plutobook-*.el9.x86_64.rpm|$(ea4_el CentOS/9 1)|check-cpanel-scripts"
    "cpanel-ubuntu2204-scripts|docker.io/library/ubuntu:22.04|oblak-ea-php84-plutobook_*_amd64.deb oblak-ea-php86-plutobook_*_amd64.deb|$(ea4_ubuntu u22)|check-cpanel-scripts"
  )
fi

# The check runs from tools/packages/, mounted at /tools, with each package under /pkg/.
# tools/packages/check-install installs, renders, removes and looks for leftovers.
selected=("$@")
mkdir -p "$logs"
failed=0
for scenario in "${scenarios[@]}"; do
  IFS='|' read -r name image globs setup check <<<"$scenario"
  if ((${#selected[@]})) && [[ " ${selected[*]} " != *" $name "* ]]; then continue; fi
  read -ra globs <<<"$globs"
  mounts=()
  for glob in "${globs[@]}"; do
    mapfile -t matches < <(compgen -G "$packages/$glob" || true)
    ((${#matches[@]} == 1)) || { echo "$name: expected one package matching $glob" >&2; failed=1; continue 2; }
    mounts+=(-v "${matches[0]}:/pkg/${matches[0]##*/}:ro")
  done
  printf '%-26s ' "$name"
  if "$engine" run --rm --quiet --security-opt label=disable "${mounts[@]}" \
      -v "$root/tools/packages:/tools:ro" "$image" bash -c \
      "{ $setup; } >/tmp/setup.log 2>&1 || { tail -20 /tmp/setup.log; exit 3; }; sh /tools/${check:-check-install}" \
      > "$logs/$name.log" 2>&1; then
    tr '\n' ' ' < "$logs/$name.log"
    echo
  else
    echo "FAILED (build/portable/package-tests/$name.log)"
    sed 's/^/    /' "$logs/$name.log" | tail -15
    failed=1
  fi
done
exit "$failed"
