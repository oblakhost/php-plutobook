#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
version=${1:-8.2.36}
flavor=nts
source "$root/scripts/php-env.sh"
qa="$root/.local/qa/bin"
tests="$root/tests/unit"
[[ -f "$root/ext/config.m4" && -d "$tests" && -n $(find "$tests" -name '*.phpt' -print -quit) ]] || {
  echo 'Coverage requires ext/config.m4 and the binding unit PHPT suite under tests/unit' >&2; exit 1;
}
base="$root/build/extension/$version/coverage"
mkdir -p "$base"
build=$(mktemp -d "$base/run.XXXXXX")
report="$root/artifacts/coverage/$version/${build##*/}"
mkdir -p "$report"
cp -Rf "$root/ext/." "$build/"
# PHPT writes failure diffs and temporary scripts beside its cases.
cp -Rf "$root/tests" "$build/test-suite"
cd "$build"
engine="$root/.local/plutobook/0.20.0"
[[ -d "$engine" ]] || { echo "Build the pinned PlutoBook library under $engine first" >&2; exit 1; }
export PKG_CONFIG_PATH="$engine/lib/pkgconfig:$engine/lib64/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$engine/lib:$engine/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
"$prefix/bin/phpize"
CC=gcc CFLAGS='-O0 -g --coverage' LDFLAGS='--coverage' ./configure --with-php-config="$prefix/bin/php-config"
make -j2 2>&1 | tee "$build/commands.log"
# Record the actual compiler invocations, including libtool and PHP include flags.
"$qa/compiledb" --parse "$build/commands.log" --output "$build/compile_commands.json"
mapfile -d '' sources < <(find src -type f -name '*.c' -print0)
((${#sources[@]} > 0))
while IFS= read -r -d '' file; do
  "$qa/clang-format" --style="file:$root/.clang-format" --dry-run --Werror "$file"
done < <(find . -type f \( -name '*.c' -o -name '*.h' \) -path './src/*' ! -name '*_arginfo.h' -print0)
"$qa/clang-tidy" --config-file="$root/.clang-tidy" -p "$build" "${sources[@]}"
runner="$root/build/php/$version/$flavor/src/run-tests.php"
export FONTCONFIG_FILE="$engine/etc/fonts/fonts.conf"
export NO_INTERACTION=1 REPORT_EXIT_STATUS=1
"$php" -n "$runner" -n -p "$php" -d "extension=$build/modules/plutobook.so" "$build/test-suite/unit" | tee "$report/phpt.log"
grep -Eq 'Tests passed *: +[1-9]' "$report/phpt.log"
"$root/scripts/check-unit-coverage" "$build" "$report"
