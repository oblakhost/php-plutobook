#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
version=0.20.0
build="$root/build/plutobook/$version"
prefix="$root/.local/plutobook/$version"
licenses="$prefix/share/licenses"
jobs=${JOBS:-$(nproc)}
if ((jobs > 6)); then jobs=6; fi
mkdir -p "$build/tmp" "$prefix" "$licenses"
exec 9>"$build/compile.lock"
flock 9
export TMPDIR="$build/tmp"
export XDG_CACHE_HOME="$root/.cache"
export PKG_CONFIG_PATH="$prefix/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Source stamps are written only after extraction finishes. Always verify the archive.
unpack() {
  local name=$1 dir=$2 archive
  archive=$("$root/scripts/fetch-source" "$name")
  if [[ ! -f "$dir/.unpacked-$name" ]]; then
    mkdir -p "$dir"
    tar -xf "$archive" --strip-components=1 -C "$dir"
    touch "$dir/.unpacked-$name"
  fi
}

# A host package satisfies a dependency unless an earlier run already built a private copy.
# The extension's remote assets need libcurl with HTTPS, so an HTTP-only host build is not enough.
host_package() {
  case $1 in
    libcurl)
      pkg-config --exists 'libcurl >= 7.68.0' &&
        [[ " $(pkg-config --variable=supported_protocols libcurl) " == *" HTTPS "* ]]
      ;;
    *) pkg-config --exists "$1" ;;
  esac
}

cmake_dependency() {
  local package=$1 archive=$2
  shift 2
  local src="$build/$package/source" obj="$build/$package/build"
  if host_package "$package" && [[ ! -d "$obj" ]]; then return; fi
  unpack "$archive" "$src"
  cmake -G Ninja -S "$src" -B "$obj" -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$prefix" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_RPATH="$prefix/lib" \
    -DBUILD_SHARED_LIBS=ON "$@"
  cmake --build "$obj" --parallel "$jobs"
  cmake --install "$obj"
  mkdir -p "$licenses/$package"
  case "$package" in
    expat) cp -f "$src/COPYING" "$licenses/$package/" ;;
    libturbojpeg) cp -f "$src"/{LICENSE.md,README.ijg} "$licenses/$package/" ;;
    libwebp) cp -f "$src"/{COPYING,PATENTS} "$licenses/$package/" ;;
    libcurl) cp -f "$src/COPYING" "$licenses/$package/" ;;
  esac
}

pkg-config --print-errors --exists cairo-fc cairo-ft cairo-png cairo-pdf freetype2 fontconfig harfbuzz icu-uc
# The invoice suite asserts on extracted text, so this build carries the text clusters patch
# like the release builds. A tree patched with another version of it is unpacked afresh.
text_patch="$root/tools/patches/plutobook-0.20.0-text-clusters.patch"
text_stamp="$build/source/.patched-text-clusters-$(sha256sum "$text_patch" | cut -c1-16)"
if compgen -G "$build/source/.patched-text-clusters-*" > /dev/null && [[ ! -f $text_stamp ]]; then
  rm -rf "$build/source"
fi
unpack 8df624e11bd55d8e4f276ebf559335aa29fb926c "$build/source"
if [[ ! -f $text_stamp ]]; then
  patch -p0 -d "$build/source" < "$text_patch"
  touch "$text_stamp"
fi
unpack meson-1.9.1.tar.gz "$build/meson-1.9.1"
"$root/scripts/stage-test-fonts" "$prefix"
mkdir -p "$licenses/plutobook"
cp -f "$build/source"/{LICENSE,CREDITS} "$licenses/plutobook/"
cp -Rf "$build/source/licenses" "$licenses/plutobook/"

cmake_dependency expat expat-2.8.2.tar.xz -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_EXAMPLES=OFF \
  -DEXPAT_BUILD_TESTS=OFF -DEXPAT_BUILD_DOCS=OFF
cmake_dependency libturbojpeg libjpeg-turbo-3.1.4.1.tar.gz -DENABLE_STATIC=OFF \
  -DWITH_TOOLS=OFF -DWITH_TESTS=OFF
cmake_dependency libwebp libwebp-1.6.0.tar.gz -DWEBP_BUILD_ANIM_UTILS=OFF -DWEBP_BUILD_CWEBP=OFF \
  -DWEBP_BUILD_DWEBP=OFF -DWEBP_BUILD_GIF2WEBP=OFF -DWEBP_BUILD_IMG2WEBP=OFF -DWEBP_BUILD_VWEBP=OFF \
  -DWEBP_BUILD_WEBPINFO=OFF -DWEBP_BUILD_WEBPMUX=OFF -DWEBP_BUILD_EXTRAS=OFF

# The extension's remote assets. HTTP and HTTPS only, through the host's OpenSSL and zlib.
cmake_dependency libcurl curl-8.23.0.tar.gz -DCURL_USE_OPENSSL=ON -DCURL_DISABLE_DICT=ON \
  -DCURL_DISABLE_FILE=ON -DCURL_DISABLE_FTP=ON -DCURL_DISABLE_GOPHER=ON -DCURL_DISABLE_IMAP=ON \
  -DCURL_DISABLE_IPFS=ON -DCURL_DISABLE_LDAP=ON -DCURL_DISABLE_LDAPS=ON -DCURL_DISABLE_MQTT=ON \
  -DCURL_DISABLE_POP3=ON -DCURL_DISABLE_RTSP=ON -DCURL_DISABLE_SMTP=ON -DCURL_DISABLE_TELNET=ON \
  -DCURL_DISABLE_TFTP=ON -DCURL_DISABLE_WEBSOCKETS=ON -DCURL_ZLIB=ON -DCURL_BROTLI=OFF -DCURL_ZSTD=OFF -DUSE_NGHTTP2=OFF -DUSE_LIBIDN2=OFF \
  -DCURL_USE_LIBPSL=OFF -DCURL_USE_LIBSSH2=OFF -DENABLE_UNIX_SOCKETS=OFF -DBUILD_CURL_EXE=OFF \
  -DBUILD_STATIC_LIBS=OFF -DBUILD_TESTING=OFF -DBUILD_LIBCURL_DOCS=OFF -DBUILD_MISC_DOCS=OFF \
  -DENABLE_CURL_MANUAL=OFF -DPICKY_COMPILER=OFF

# PlutoBook's own curl support stays off: the binding fetches every remote asset itself.
# Meson link options replace LDFLAGS, so pass a packager's LDFLAGS along with the private rpath.
read -r -a ldflags <<< "${LDFLAGS:-}"
link_args=$(printf "'%s'," "-Wl,-rpath,$prefix/lib" ${ldflags[@]+"${ldflags[@]}"})
meson=(python3 "$build/meson-1.9.1/meson.py")
setup=()
if [[ -f "$build/obj/meson-private/coredata.dat" ]]; then setup+=(--reconfigure); fi
"${meson[@]}" setup "${setup[@]}" --prefix="$prefix" --libdir=lib --buildtype=release \
  --wrap-mode=nofallback -Ddefault_library=shared -Dcurl=disabled -Dturbojpeg=enabled \
  -Dcpp_link_args="[${link_args%,}]" -Dwebp=enabled -Dtools=enabled "$build/obj" "$build/source"
"${meson[@]}" compile -C "$build/obj" -j "$jobs"
"${meson[@]}" install -C "$build/obj" --no-rebuild
pkg-config --exact-version="$version" plutobook
