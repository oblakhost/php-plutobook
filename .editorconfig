root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 4

[*.{c,h}]
indent_style = tab
indent_size = 4

[Makefile*]
indent_style = tab

[*.{php,phpt}]
indent_size = 4

[*.phpt]
trim_trailing_whitespace = false

[*.md]
max_line_length = 100
trim_trailing_whitespace = false

[*.{pdf,png,jpg,woff,woff2,ttf,otf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
