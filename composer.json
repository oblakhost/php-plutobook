{
  "name": "oblakhost/ext-plutobook",
  "description": "Native PHP extension for rendering HTML and CSS to PDF with PlutoBook",
  "homepage": "https://php.plutobook.dev",
  "type": "php-ext",
  "require": {
    "php": ">=8.2 <8.7"
  },
  "php-ext": {
    "extension-name": "plutobook",
    "build-path": "ext",
    "support-zts": true,
    "support-nts": true,
    "os-families": [
      "linux",
      "windows"
    ],
    "download-url-method": [
      "pre-packaged-binary",
      "pre-packaged-source"
    ]
  },
  "license": "Apache-2.0"
}
